{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Neuronautix/FAIR.md/main/schema/fair.schema.json",
  "title": "fair.md YAML front-matter schema",
  "description": "JSON Schema (draft 2020-12) for fair.md YAML front matter. Versions 0.1 and 0.2 remain supported; version 0.3 adds evidence-backed assessments, implementation profiles, and a separate openness declaration.",
  "type": "object",
  "required": [
    "fair_md_version",
    "title",
    "description",
    "identifiers",
    "maintainers",
    "license",
    "data_resources",
    "vocabularies",
    "fair_assessment",
    "companions",
    "maturity",
    "last_reviewed"
  ],
  "additionalProperties": true,
  "properties": {
    "fair_md_version": {
      "type": "string",
      "description": "Version of the fair.md specification this file conforms to. Versions 0.1 and 0.2 remain accepted for backward compatibility.",
      "enum": ["0.1", "0.2", "0.3"]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Short, human-readable name for the repository or dataset."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Paragraph-length description of what the repository contains."
    },
    "identifiers": {
      "type": "object",
      "required": ["repository", "homepage", "canonical", "doi"],
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "description": "URL of the source code or data repository."
        },
        "homepage": {
          "type": "string",
          "format": "uri",
          "description": "Canonical homepage of the project."
        },
        "canonical": {
          "type": "string",
          "format": "uri",
          "description": "Stable URL where this fair.md file is served."
        },
        "doi": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^10\\.[0-9]{4,9}/\\S+$",
              "description": "DOI if minted, e.g. '10.5281/zenodo.1234567'."
            },
            {
              "type": "null",
              "description": "null if no DOI has been minted yet."
            }
          ]
        }
      }
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "description": "Accountable people for this repository.",
      "items": {
        "type": "object",
        "required": ["name", "role"],
        "additionalProperties": true,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Full name of the maintainer."
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "description": "Role(s) with respect to the repository."
          },
          "orcid": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$",
            "description": "ORCID iD in the format 0000-0000-0000-000X."
          },
          "org": {
            "type": "string",
            "description": "Institutional affiliation."
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": ["content", "code"],
      "additionalProperties": false,
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1,
          "description": "SPDX license identifier for content/data, or 'unspecified'."
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "SPDX license identifier for code, or 'unspecified'."
        }
      }
    },
    "data_resources": {
      "type": "array",
      "minItems": 1,
      "description": "The FAIR objects this manifest covers.",
      "items": {
        "type": "object",
        "required": ["id", "path", "type"],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9-_]+$",
            "description": "Short identifier for this resource (no spaces)."
          },
          "path": {
            "type": "string",
            "pattern": "^/",
            "description": "Root path of this resource within the repository or site."
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "description": "Human-readable description of the resource type and format."
          },
          "topics": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Topical keywords for this resource."
          },
          "count": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0,
                "description": "Number of items in the collection."
              },
              {
                "type": "null"
              }
            ]
          },
          "identifier": {
            "oneOf": [
              {
                "type": "string",
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "description": "Globally unique, preferably persistent and resolvable identifier for this resource."
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "description": "IANA media type for the resource representation."
          },
          "metadata": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/reference"
            },
            "description": "Metadata records that explicitly describe this resource."
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "description": "SPDX identifier or license URI applying to this resource."
          },
          "conforms_to": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            },
            "description": "Persistent identifiers of standards or profiles implemented by this resource."
          }
        }
      }
    },
    "vocabularies": {
      "type": "array",
      "description": "Controlled vocabularies, ontologies, and data standards referenced.",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "$ref": "#/$defs/identifiedVocabulary"
          }
        ]
      }
    },
    "fair_assessment": {
      "type": "object",
      "required": ["findable", "accessible", "interoperable", "reusable"],
      "additionalProperties": false,
      "description": "FAIR self-assessment grouped by principle.",
      "properties": {
        "findable": {
          "type": "object",
          "required": [
            "F1_globally_unique_persistent_id",
            "F2_rich_metadata",
            "F3_metadata_references_data_id",
            "F4_indexed_searchable"
          ],
          "additionalProperties": false,
          "properties": {
            "F1_globally_unique_persistent_id": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "F2_rich_metadata": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "F3_metadata_references_data_id": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "F4_indexed_searchable": {
              "$ref": "#/$defs/assessmentEntry"
            }
          }
        },
        "accessible": {
          "type": "object",
          "required": [
            "A1_retrievable_by_id_open_protocol",
            "A1.1_protocol_open_free",
            "A1.2_auth_where_needed",
            "A2_metadata_persist_beyond_data"
          ],
          "additionalProperties": false,
          "properties": {
            "A1_retrievable_by_id_open_protocol": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "A1.1_protocol_open_free": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "A1.2_auth_where_needed": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "A2_metadata_persist_beyond_data": {
              "$ref": "#/$defs/assessmentEntry"
            }
          }
        },
        "interoperable": {
          "type": "object",
          "required": [
            "I1_formal_accessible_knowledge_representation",
            "I2_FAIR_vocabularies",
            "I3_qualified_references"
          ],
          "additionalProperties": false,
          "properties": {
            "I1_formal_accessible_knowledge_representation": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "I2_FAIR_vocabularies": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "I3_qualified_references": {
              "$ref": "#/$defs/assessmentEntry"
            }
          }
        },
        "reusable": {
          "type": "object",
          "required": [
            "R1_plurality_of_attributes",
            "R1.1_clear_data_usage_license",
            "R1.2_detailed_provenance",
            "R1.3_domain_community_standards"
          ],
          "additionalProperties": false,
          "properties": {
            "R1_plurality_of_attributes": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "R1.1_clear_data_usage_license": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "R1.2_detailed_provenance": {
              "$ref": "#/$defs/assessmentEntry"
            },
            "R1.3_domain_community_standards": {
              "$ref": "#/$defs/assessmentEntry"
            }
          }
        }
      }
    },
    "companions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/companionPath"
      },
      "description": "Paths to companion machine-readable artifacts, or null if absent.",
      "properties": {
        "trust": {
          "$ref": "#/$defs/companionPath"
        },
        "sitemap": {
          "$ref": "#/$defs/companionPath"
        },
        "robots": {
          "$ref": "#/$defs/companionPath"
        },
        "citation_cff": {
          "$ref": "#/$defs/companionPath"
        },
        "codemeta": {
          "$ref": "#/$defs/companionPath"
        },
        "ro_crate": {
          "$ref": "#/$defs/companionPath"
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "description": "Community or implementation profiles used to turn the generic FAIR principles into concrete choices.",
      "items": {
        "type": "object",
        "required": ["name", "identifier", "status", "applies_to"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "identifier": {
            "type": "string",
            "format": "uri"
          },
          "registry": {
            "type": "string",
            "format": "uri"
          },
          "status": {
            "type": "string",
            "enum": ["adopted", "aligned", "planned", "not-applicable"]
          },
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "openness": {
      "$ref": "#/$defs/opennessDeclaration"
    },
    "maturity": {
      "type": "string",
      "enum": ["prototype", "beta", "stable"],
      "description": "Maturity level of this repository's FAIR posture."
    },
    "last_reviewed": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "ISO 8601 date (YYYY-MM-DD) of the last honest review."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "fair_md_version": {
            "const": "0.3"
          }
        },
        "required": ["fair_md_version"]
      },
      "then": {
        "required": ["profiles", "openness"],
        "properties": {
          "data_resources": {
            "items": {
              "required": ["identifier", "media_type", "metadata", "license"]
            }
          },
          "vocabularies": {
            "items": {
              "$ref": "#/$defs/identifiedVocabulary"
            }
          },
          "fair_assessment": {
            "properties": {
              "findable": {
                "additionalProperties": {
                  "$ref": "#/$defs/evidencedAssessment"
                }
              },
              "accessible": {
                "additionalProperties": {
                  "$ref": "#/$defs/evidencedAssessment"
                }
              },
              "interoperable": {
                "additionalProperties": {
                  "$ref": "#/$defs/evidencedAssessment"
                }
              },
              "reusable": {
                "additionalProperties": {
                  "$ref": "#/$defs/evidencedAssessment"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "fairStatus": {
      "type": "string",
      "enum": ["yes", "partial", "planned", "no", "n/a"],
      "description": "FAIR self-assessment status: yes | partial | planned | no | n/a"
    },
    "assessmentEntry": {
      "oneOf": [
        {
          "$ref": "#/$defs/fairStatus"
        },
        {
          "$ref": "#/$defs/evidencedAssessment"
        }
      ]
    },
    "evidencedAssessment": {
      "type": "object",
      "required": ["status", "evidence"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/fairStatus"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "metric_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Assessment indicator identifiers, preferably from the RDA FAIR Data Maturity Model."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/reference"
        },
        "type": {
          "type": "string",
          "enum": [
            "automated-test",
            "metadata-record",
            "persistent-identifier",
            "policy",
            "provenance",
            "registry-record",
            "standard",
            "other"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "string",
      "pattern": "^(/|https?://)",
      "description": "Root-relative path or absolute HTTP(S) URI."
    },
    "identifiedVocabulary": {
      "type": "object",
      "required": ["name", "identifier"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "identifier": {
          "type": "string",
          "format": "uri"
        },
        "version": {
          "type": "string"
        },
        "registry": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "opennessDeclaration": {
      "type": "object",
      "required": [
        "open_definition_version",
        "status",
        "license_status",
        "access",
        "machine_readable",
        "open_format",
        "source_available",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "open_definition_version": {
          "type": "string",
          "const": "2.1"
        },
        "status": {
          "type": "string",
          "enum": ["conformant", "partly-conformant", "not-conformant", "not-assessed"]
        },
        "license_status": {
          "type": "string",
          "enum": ["open", "mixed", "restricted", "unspecified"]
        },
        "access": {
          "type": "string",
          "enum": ["open", "conditional", "restricted", "closed"]
        },
        "machine_readable": {
          "type": "boolean"
        },
        "open_format": {
          "type": "boolean"
        },
        "source_available": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      }
    },
    "companionPath": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(/|https?://)",
          "description": "Root-relative path (e.g. '/trust.md') or absolute http(s) URL to the companion artifact."
        },
        {
          "type": "null",
          "description": "null if the companion artifact does not exist yet."
        }
      ]
    }
  }
}
